@{
    ViewData["Title"] = "Plataformas";
}
<div class="topbar">
    <span class="topbar-title">Plataformas</span>
    <button class="btn btn-primary" onclick="openModal()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        Nueva plataforma
    </button>
</div>

<div class="content">
    <div class="card">
        <div class="card-header">
            <span class="card-title">Plataformas del sistema</span>
        </div>
        <table>
            <thead>
                <tr><th>Nombre</th><th>Descripción</th><th>Fecha</th><th></th></tr>
            </thead>
            <tbody id="platforms-body">
                <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:20px">Cargando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal-overlay" id="modal">
    <div class="modal">
        <div class="modal-header">
            <h3 id="modal-title">Nueva plataforma</h3>
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="edit-id" value="">
            <div class="field-group">
                <label>Nombre</label>
                <input type="text" id="plat-name" placeholder="Ej: Aplicaciones móviles">
            </div>
            <div class="field-group">
                <label>Descripción</label>
                <textarea id="plat-desc" placeholder="Describe esta plataforma..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" onclick="closeModal()">Cancelar</button>
            <button class="btn btn-primary" onclick="savePlatform()">Guardar</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

async function loadPlatforms() {
    const response = await fetch('/Platforms/GetAll');
    if (!response.ok) return;
    const platforms = await response.json();
    const tbody = document.getElementById('platforms-body');
    if (platforms.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:20px">No hay plataformas aún</td></tr>';
        return;
    }
    tbody.innerHTML = platforms.map(p => `
        <tr>
            <td><div class="t-title">${p.name}</div></td>
            <td style="color:var(--text-secondary);font-size:13px">${p.description ?? '—'}</td>
            <td class="t-date">${new Date(p.createdAt).toLocaleDateString('es-MX')}</td>
            <td>
                <button class="btn btn-ghost row-action" style="padding:5px 10px;font-size:12px"
                    onclick="openEditModal('${p.id}', '${p.name}', '${p.description ?? ''}')">
                    Editar
                </button>
            </td>
        </tr>
    `).join('');
}

function openModal() {
    document.getElementById('modal-title').textContent = 'Nueva plataforma';
    document.getElementById('edit-id').value = '';
    document.getElementById('plat-name').value = '';
    document.getElementById('plat-desc').value = '';
    document.getElementById('modal').classList.add('show');
}

function openEditModal(id, name, desc) {
    document.getElementById('modal-title').textContent = 'Editar plataforma';
    document.getElementById('edit-id').value = id;
    document.getElementById('plat-name').value = name;
    document.getElementById('plat-desc').value = desc;
    document.getElementById('modal').classList.add('show');
}

function closeModal() { document.getElementById('modal').classList.remove('show'); }

async function savePlatform() {
    const id = document.getElementById('edit-id').value;
    const name = document.getElementById('plat-name').value.trim();
    const description = document.getElementById('plat-desc').value.trim();

    if (!name) { alert('El nombre es obligatorio.'); return; }

    const url = id ? `/Platforms/Update/${id}` : '/Platforms/Create';
    const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify({ name, description })
    });

    if (response.ok) {
        closeModal();
        showToast(id ? 'Plataforma actualizada ✓' : 'Plataforma creada ✓');
        await loadPlatforms();
    } else {
        showToast('Error al guardar la plataforma');
    }
}

let toastTimer;
function showToast(msg) {
    const t = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}

document.getElementById('modal').addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });
document.addEventListener('DOMContentLoaded', loadPlatforms);
</script>
}
