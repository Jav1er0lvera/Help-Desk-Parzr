@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="topbar">
    <span class="topbar-title">Error</span>
</div>

<div class="content">
    <div class="card">
        <div class="card-header"><span class="card-title">Ocurrió un error</span></div>
        <p style="padding:16px;color:var(--text-secondary)">Algo salió mal al procesar tu solicitud. Intenta de nuevo.</p>
        @if (Model.ShowRequestId)
        {
            <p style="padding:0 16px 16px;color:var(--text-muted);font-size:13px">ID de solicitud: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
