@model List<HelpDesk.Web.Controllers.TicketViewModel>
@{
Layout = null;
ViewData["Title"] = "Dashboard";
var userName = User.Identity?.Name ?? "Usuario";
var userInitials = string.Join("", userName.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()));
var role = ViewBag.Role as string ?? "Usuario";
var tickets = Model ?? [];
}
<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Dashboard — HelpDesk</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="~/css/helpdesk.css" asp-append-version="true" />
    </head>
    <body>

        <nav class="sidebar">
            <div class="sidebar-logo">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0z"/></svg>
                <div><span>HelpDesk</span><small>Parzr LLC</small></div>
            </div>
            <div class="nav-section">Principal</div>
            <div class="nav-item active" onclick="showView('dashboard', this)">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Dashboard
            </div>
            <div class="nav-item" onclick="showView('tickets', this)">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 0 0-2 2v3a2 2 0 0 1 0 4v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3a2 2 0 0 1 0-4V7a2 2 0 0 0-2-2H5z"/></svg>
                Tickets
                <span class="nav-badge">@Model.Count(t => t.Status == "Abierto")</span>
            </div>
            @if (role == "Supervisor")
            {
                <div class="nav-section">Admin</div>
                <div class="nav-item" onclick="showView('metrics', this)">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/></svg>
                    Métricas
                </div>
                <a class="nav-item" asp-controller="Platforms" asp-action="Index">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3"/></svg>
                    Plataformas
                </a>
                <a class="nav-item" asp-controller="Categories" asp-action="Index">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/><path d="M6 6h.008v.008H6V6Z"/></svg>
                    Categorías
                </a>
            }
            <div class="sidebar-footer">
                <div class="user-chip">
                    <div class="avatar av-blue">@userInitials</div>
                    <div class="user-info">
                        <span>@userName</span>
                        <small>@role</small>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin-top:8px">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost" style="width:100%;justify-content:center;font-size:12px;padding:6px">
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </nav>

        <div class="main">
            <div class="topbar">
                <span class="topbar-title" id="page-title">Dashboard</span>
                <div class="search">
                    <svg width="14" height="14" fill="none" stroke="#94A3B8" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    <input type="text" id="search-input" placeholder="Buscar ticket..." oninput="searchTickets(this.value)">
                </div>
                @if (role == "Usuario")
                {
                    <button class="btn btn-primary" onclick="openModal()">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                        Nuevo ticket
                    </button>
                }
            </div>

            <div class="content">

                <div class="view active" id="view-dashboard">
                    <div class="kpis">
                        <div class="kpi-card">
                            <div class="kpi-label"><span class="kpi-dot" style="background:var(--red)"></span>Abiertos</div>
                            <div class="kpi-value" style="color:var(--red)">@Model.Count(t => t.Status == "Abierto")</div>
                            <div class="kpi-sub" style="color:var(--red-text)">tickets abiertos</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><span class="kpi-dot" style="background:var(--amber)"></span>En progreso</div>
                            <div class="kpi-value" style="color:var(--amber)">@Model.Count(t => t.Status == "En progreso")</div>
                            <div class="kpi-sub" style="color:var(--amber-text)">en atención</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><span class="kpi-dot" style="background:var(--green)"></span>Resueltos</div>
                            <div class="kpi-value" style="color:var(--green)">@Model.Count(t => t.Status == "Resuelto")</div>
                            <div class="kpi-sub" style="color:var(--green-text)">completados</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-label"><span class="kpi-dot" style="background:var(--purple)"></span>Total</div>
                            <div class="kpi-value" style="color:var(--purple)">@Model.Count</div>
                            <div class="kpi-sub" style="color:var(--purple-text)">tickets en sistema</div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <span class="card-title">Tickets recientes</span>
                            <button class="btn btn-ghost" onclick="showView('tickets', document.querySelectorAll('.nav-item')[1])">Ver todos →</button>
                        </div>
                        <table>
                            <thead><tr><th>#</th><th>Título</th><th>Prioridad</th><th>Estado</th><th>Creado por</th><th>Fecha</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var ticket in Model.OrderByDescending(t => t.CreatedAt).Take(4))
                                {
                                    <tr>
                                        <td class="t-ticket-id">#@ticket.Id.ToString()[..8]</td>
                                        <td><div class="t-title">@ticket.Title</div><div class="t-user">@ticket.CreatedByName</div></td>
                                        <td><span class="badge @(ticket.Priority == "Urgente" ? "badge-urgent" : ticket.Priority == "Media" ? "badge-medium" : "badge-low")">@ticket.Priority</span></td>
                                        <td><span class="badge @(ticket.Status == "Abierto" ? "badge-open" : ticket.Status == "En progreso" ? "badge-progress" : "badge-closed")">@ticket.Status</span></td>
                                        <td class="t-user">@ticket.CreatedByName</td>
                                        <td class="t-date">@ticket.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td><a class="btn btn-ghost row-action" style="padding:5px 10px;font-size:12px" asp-controller="Home" asp-action="TicketDetail" asp-route-id="@ticket.Id">Ver →</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="view" id="view-tickets">
                    <div class="card">
                        <div class="card-header">
                            <span class="card-title">Todos los tickets</span>
                            <div class="filters">
                                <button class="filter-chip active" onclick="filterTickets('todos', this)">Todos</button>
                                <button class="filter-chip" onclick="filterTickets('Abierto', this)">Abiertos</button>
                                <button class="filter-chip" onclick="filterTickets('En progreso', this)">En progreso</button>
                                <button class="filter-chip" onclick="filterTickets('Resuelto', this)">Resueltos</button>
                            </div>
                        </div>
                        <table>
                            <thead><tr><th>#</th><th>Título</th><th>Prioridad</th><th>Estado</th><th>Creado por</th><th>Fecha</th><th></th></tr></thead>
                            <tbody id="all-tickets-body">
                                @foreach (var ticket in Model.OrderByDescending(t => t.CreatedAt))
                                {
                                    <tr data-status="@ticket.Status">
                                        <td class="t-ticket-id">#@ticket.Id.ToString()[..8]</td>
                                        <td><div class="t-title">@ticket.Title</div></td>
                                        <td><span class="badge @(ticket.Priority == "Urgente" ? "badge-urgent" : ticket.Priority == "Media" ? "badge-medium" : "badge-low")">@ticket.Priority</span></td>
                                        <td><span class="badge @(ticket.Status == "Abierto" ? "badge-open" : ticket.Status == "En progreso" ? "badge-progress" : "badge-closed")">@ticket.Status</span></td>
                                        <td class="t-user">@ticket.CreatedByName</td>
                                        <td class="t-date">@ticket.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td><a class="btn btn-ghost row-action" style="padding:5px 10px;font-size:12px" asp-controller="Home" asp-action="TicketDetail" asp-route-id="@ticket.Id">Ver →</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="view" id="view-metrics">
                    <div class="kpis">
                        <div class="kpi-card"><div class="kpi-label">Total tickets</div><div class="kpi-value">@Model.Count</div></div>
                        <div class="kpi-card"><div class="kpi-label">Resueltos</div><div class="kpi-value" style="color:var(--green)">@Model.Count(t => t.Status == "Resuelto")</div></div>
                        <div class="kpi-card"><div class="kpi-label">Abiertos</div><div class="kpi-value" style="color:var(--red)">@Model.Count(t => t.Status == "Abierto")</div></div>
                        <div class="kpi-card"><div class="kpi-label">En progreso</div><div class="kpi-value" style="color:var(--amber)">@Model.Count(t => t.Status == "En progreso")</div></div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <span class="card-title" id="metrics-title">Tickets por plataforma</span>
                            <button class="btn btn-ghost" id="btn-back-platform" style="display:none" onclick="showPlatforms()">← Volver</button>
                        </div>
                        <div id="platforms-chart"></div>
                        <div id="categories-chart" style="display:none"></div>
                    </div>
                </div>

            </div>
        </div>

        @if (role == "Usuario")
        {
            <div class="modal-overlay" id="modal">
                <div class="modal">
                    <div class="modal-header">
                        <h3>Nuevo ticket</h3>
                        <button class="close-btn" onclick="closeModal()">×</button>
                    </div>
                    <div class="modal-body">
                        <div class="field-group"><label>Título</label><input type="text" id="new-title" placeholder="Ej: No puedo acceder al correo corporativo"></div>
                        <div class="field-group"><label>Descripción</label><textarea id="new-desc" placeholder="Describe el problema con detalle..."></textarea></div>
                        <div class="field-group">
                            <label>Plataforma</label>
                            <select id="new-platform" onchange="loadCategoriesByPlatform(this.value)">
                                <option value="">Selecciona una plataforma</option>
                            </select>
                        </div>
                        <div class="field-group">
                            <label>Categoría</label>
                            <select id="new-category">
                                <option value="">Primero selecciona una plataforma</option>
                            </select>
                        </div>
                        <div class="field-group">
                            <label>Prioridad</label>
                            <select id="new-priority"><option>Urgente</option><option selected>Media</option><option>Baja</option></select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-ghost" onclick="closeModal()">Cancelar</button>
                        <button class="btn btn-primary" onclick="createTicket()">Crear ticket</button>
                    </div>
                </div>
            </div>
        }

        <div class="toast" id="toast">
            <svg width="16" height="16" fill="none" stroke="#10B981" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
            <span id="toast-msg"></span>
        </div>

        @Html.AntiForgeryToken()

        <script>
            const role = '@role';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            function showView(name, navEl) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.getElementById('view-' + name).classList.add('active');
            if (navEl) {
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            navEl.classList.add('active');
        }
        const titles = { dashboard: 'Dashboard', tickets: 'Tickets', metrics: 'Métricas' };
        document.getElementById('page-title').textContent = titles[name] || name;
    }

    function filterTickets(filter, el) {
    document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
    document.querySelectorAll('#all-tickets-body tr').forEach(row => {
    const status = row.getAttribute('data-status');
    row.style.display = (filter === 'todos' || status === filter) ? '' : 'none';
    });
}

function searchTickets(query) {
const q = query.toLowerCase();
document.querySelectorAll('#all-tickets-body tr').forEach(row => {
row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
});
if (q.length > 0) showView('tickets', document.querySelectorAll('.nav-item')[1]);
}

async function loadPlatforms() {
const response = await fetch('/Platforms/GetAll');
if (!response.ok) return;
const platforms = await response.json();
const select = document.getElementById('new-platform');
if (!select) return;
select.innerHTML = '<option value="">Selecciona una plataforma</option>' +
platforms.map(p => `<option value="${p.id}">${p.name}</option>`).join('');
}

async function loadCategoriesByPlatform(platformId) {
const select = document.getElementById('new-category');
if (!platformId) {
select.innerHTML = '<option value="">Primero selecciona una plataforma</option>';
return;
}
const response = await fetch(`/Platforms/GetCategories/${platformId}`);
if (!response.ok) return;
const categories = await response.json();
if (categories.length === 0) {
select.innerHTML = '<option value="">Sin categorías para esta plataforma</option>';
return;
}
select.innerHTML = '<option value="">Selecciona una categoría</option>' +
categories.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
}

function openModal() {
document.getElementById('modal')?.classList.add('show');
loadPlatforms();
}

function closeModal() { document.getElementById('modal')?.classList.remove('show'); }

let toastTimer;
function showToast(msg) {
const t = document.getElementById('toast');
document.getElementById('toast-msg').textContent = msg;
t.classList.add('show');
clearTimeout(toastTimer);
toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}

async function createTicket() {
const title = document.getElementById('new-title').value.trim();
if (!title) { alert('Escribe un título para el ticket.'); return; }
const priority = document.getElementById('new-priority').value;
const desc = document.getElementById('new-desc').value || '';
const categoryId = document.getElementById('new-category').value;

const response = await fetch('/Tickets/Create', {
method: 'POST',
headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
body: JSON.stringify({ title, description: desc, priority, categoryId: categoryId || null })
});

if (response.ok) {
closeModal();
showToast('Ticket creado exitosamente ✓');
setTimeout(() => location.reload(), 1500);
}
else
{
    showToast('Error al crear el ticket');
}
}

const ticketsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(t => new {
id = t.Id,
status = t.Status,
platformName = t.PlatformName,
categoryName = t.CategoryName
})));

function showPlatforms() {
document.getElementById('metrics-title').textContent = 'Tickets por plataforma';
document.getElementById('btn-back-platform').style.display = 'none';
document.getElementById('categories-chart').style.display = 'none';
document.getElementById('platforms-chart').style.display = '';

const platforms = {};
ticketsData.forEach(t => {
platforms[t.platformName] = (platforms[t.platformName] || 0) + 1;
});

document.getElementById('platforms-chart').innerHTML = `
<table>
    <thead><tr><th>Plataforma</th><th>Tickets</th><th></th></tr></thead>
    <tbody>
        ${Object.entries(platforms).map(([name, count]) => `
        <tr>
            <td><div class="t-title">${name}</div></td>
            <td><span class="badge badge-progress">${count}</span></td>
            <td><button class="btn btn-ghost row-action" style="padding:5px 10px;font-size:12px" onclick="showCategories('${name}')">Ver categorías →</button></td>
        </tr>
        `).join('')}
    </tbody>
</table>`;
}

function showCategories(platformName) {
document.getElementById('metrics-title').textContent = `Categorías — ${platformName}`;
document.getElementById('btn-back-platform').style.display = '';
document.getElementById('platforms-chart').style.display = 'none';
document.getElementById('categories-chart').style.display = '';

const filtered = ticketsData.filter(t => t.platformName === platformName);
const categories = {};
filtered.forEach(t => {
categories[t.categoryName] = (categories[t.categoryName] || 0) + 1;
});

document.getElementById('categories-chart').innerHTML = `
<table>
    <thead><tr><th>Categoría</th><th>Tickets</th></tr></thead>
    <tbody>
        ${Object.entries(categories).map(([name, count]) => `
        <tr>
            <td><div class="t-title">${name}</div></td>
            <td><span class="badge badge-medium">${count}</span></td>
        </tr>
        `).join('')}
    </tbody>
</table>`;
}

// Inicializar métricas al mostrar la vista
const originalShowView = showView;
showView = function(name, navEl) {
originalShowView(name, navEl);
if (name === 'metrics') showPlatforms();
};

document.getElementById('modal')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });
</script>

</body>
</html>