@model HelpDesk.Web.Controllers.TicketViewModel
@{
Layout = null;
ViewData["Title"] = "Detalle de ticket";
var userName = User.Identity?.Name ?? "Usuario";
var userInitials = string.Join("", userName.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()));
var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario";
}
<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Ticket — HelpDesk</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="~/css/helpdesk.css" asp-append-version="true" />
    </head>
    <body>

        <nav class="sidebar">
            <div class="sidebar-logo">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0z"/></svg>
                <div><span>HelpDesk</span><small>Parzr LLC</small></div>
            </div>
            <div class="nav-section">Principal</div>
            <a class="nav-item" asp-controller="Home" asp-action="Dashboard">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Dashboard
            </a>
            <a class="nav-item active" asp-controller="Home" asp-action="Dashboard">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 0 0-2 2v3a2 2 0 0 1 0 4v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3a2 2 0 0 1 0-4V7a2 2 0 0 0-2-2H5z"/></svg>
                Tickets
            </a>
            @if (role == "Supervisor")
            {
                <div class="nav-section">Admin</div>
                <a class="nav-item" asp-controller="Categories" asp-action="Index">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/><path d="M6 6h.008v.008H6V6Z"/></svg>
                    Categorías
                </a>
            }
            <div class="sidebar-footer">
                <div class="user-chip">
                    <div class="avatar av-blue">@userInitials</div>
                    <div class="user-info">
                        <span>@userName</span>
                        <small>@role</small>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin-top:8px">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost" style="width:100%;justify-content:center;font-size:12px;padding:6px">
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </nav>

        <div class="main">
            <div class="topbar">
                <span class="topbar-title">Detalle de ticket</span>
            </div>

            <div class="content">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                    <a class="btn btn-ghost" asp-controller="Home" asp-action="Dashboard">← Volver</a>
                    <span style="font-size:13px; color:var(--text-muted)">Tickets / #@Model.Id.ToString()[..8] — @Model.Title</span>
                </div>

                <div class="ticket-layout">
                    <div class="ticket-main">
                        <div class="ticket-header-card">
                            <div class="ticket-title">@Model.Title</div>
                            <div class="ticket-meta">
                                <span class="badge @(Model.Status == "Abierto" ? "badge-open" : Model.Status == "En progreso" ? "badge-progress" : "badge-closed")">@Model.Status</span>
                                <span class="badge @(Model.Priority == "Urgente" ? "badge-urgent" : Model.Priority == "Media" ? "badge-medium" : "badge-low")">@Model.Priority</span>
                            </div>
                            <div class="ticket-desc">@Model.Description</div>
                        </div>

                        <div class="chat-card">
                            <div class="card-header"><span class="card-title">Comentarios</span></div>
                            <div class="chat-messages" id="chat-messages"></div>
                            <div class="chat-input-row">
                                <input type="text" id="chat-input" placeholder="Escribe una respuesta..." onkeydown="if(event.key==='Enter') sendMsg()">
                                <button class="btn btn-primary" onclick="sendMsg()">Enviar</button>
                            </div>
                        </div>
                    </div>

                    <div class="ticket-sidebar">
                        <div class="info-card">
                            <h4>Detalles</h4>
                            <div class="info-row"><label>Estado</label><span class="badge @(Model.Status == "Abierto" ? "badge-open" : Model.Status == "En progreso" ? "badge-progress" : "badge-closed")">@Model.Status</span></div>
                            <div class="info-row"><label>Prioridad</label><span class="badge @(Model.Priority == "Urgente" ? "badge-urgent" : Model.Priority == "Media" ? "badge-medium" : "badge-low")">@Model.Priority</span></div>
                            <div class="info-row"><label>Creado por</label><span>@Model.CreatedByName</span></div>
                            <div class="info-row"><label>Técnico</label><span>@(string.IsNullOrEmpty(Model.AssignedToName) ? "Sin asignar" : Model.AssignedToName)</span></div>
                            <div class="info-row"><label>Fecha</label><span>@Model.CreatedAt.ToString("dd/MM/yyyy")</span></div>
                            <div class="info-row">
                                <label>@(Model.Status == "Resuelto" ? "Tiempo de resolución" : "Tiempo abierto")</label>
                                <span>
                                    @{
                                    var fechaFin = Model.ResolvedAt ?? DateTime.UtcNow;
                                    var dias = (fechaFin - Model.CreatedAt).Days;
                                    var texto = dias == 0 ? "Hoy" : dias == 1 ? "1 día" : $"{dias} días";
                                }
                                @texto
                            </span>
                        </div>
                    </div>

                    @if (role == "Supervisor" || role == "Soporte")
                    {
                        <div class="info-card">
                            <h4>Cambiar estado</h4>
                            <select class="select-field" id="status-select" onchange="updateStatus(this.value)">
                                <option value="Abierto" selected="@(Model.Status == "Abierto" ? "selected" : null)">Abierto</option>
                                <option value="En progreso" selected="@(Model.Status == "En progreso" ? "selected" : null)">En progreso</option>
                                <option value="Resuelto" selected="@(Model.Status == "Resuelto" ? "selected" : null)">Resuelto</option>
                            </select>
                        </div>
                    }

                    @if (role == "Supervisor")
                    {
                        <div class="info-card">
                            <h4>Asignar técnico</h4>
                            <select class="select-field" id="tech-select" onchange="assignTicket(this.value)">
                                <option value="">Cargando técnicos...</option>
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="toast" id="toast">
        <svg width="16" height="16" fill="none" stroke="#10B981" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
        <span id="toast-msg"></span>
    </div>

    @Html.AntiForgeryToken()

    <script>
        const ticketId = '@Model.Id';
        const userId = '@Html.Raw(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")';
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        async function loadComments() {
        const response = await fetch(`/Tickets/Comments/${ticketId}`);
        if (!response.ok) return;
        const comments = await response.json();
        const chat = document.getElementById('chat-messages');
        chat.innerHTML = '';
        if (comments.length === 0) {
        chat.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:20px;font-size:13px">Sin comentarios aún</p>';
        return;
    }
    comments.forEach(c => {
    const d = document.createElement('div');
    d.className = 'msg';
    const initials = c.authorName.split(' ').map(w => w[0]).join('').toUpperCase();
    d.innerHTML = `
    <div class="avatar av-blue" style="width:30px;height:30px;font-size:11px;flex-shrink:0">${initials}</div>
    <div class="msg-content">
        <div class="msg-author">${c.authorName}</div>
        <div class="msg-text">${c.message}</div>
        <div class="msg-time">${new Date(c.createdAt).toLocaleString('es-MX')}</div>
    </div>`;
    chat.appendChild(d);
    });
    chat.scrollTop = chat.scrollHeight;
}

async function loadSoporte() {
const select = document.getElementById('tech-select');
if (!select) return;
const response = await fetch('/Tickets/GetSoporte');
if (!response.ok) return;
const users = await response.json();
select.innerHTML = '<option value="">Sin asignar</option>' +
users.map(u => `<option value="${u.id}">${u.firstName} ${u.lastName}</option>`).join('');
}

async function sendMsg() {
const input = document.getElementById('chat-input');
const val = input.value.trim();
if (!val) return;

const response = await fetch(`/Tickets/AddComment/${ticketId}`, {
method: 'POST',
headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
body: JSON.stringify({ message: val, authorId: userId })
});

if (response.ok) {
input.value = '';
await loadComments();
showToast('Comentario enviado ✓');
}
else
{
    showToast('Error al enviar el comentario');
}
}

async function updateStatus(status) {
const response = await fetch(`/Tickets/UpdateStatus/${ticketId}`, {
method: 'POST',
headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
body: JSON.stringify({ status })
});

if (response.ok) {
showToast(`Estado actualizado a "${status}" ✓`);
}
else
{
    showToast('Error al actualizar el estado');
}
}

async function assignTicket(userId) {
if (!userId) return;
const response = await fetch(`/Tickets/Assign/${ticketId}`, {
method: 'POST',
headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
body: JSON.stringify({ assignedToUserId: userId })
});

if (response.ok) {
showToast('Ticket asignado correctamente ✓');
}
else
{
    showToast('Error al asignar el ticket');
}
}

let toastTimer;
function showToast(msg) {
const t = document.getElementById('toast');
document.getElementById('toast-msg').textContent = msg;
t.classList.add('show');
clearTimeout(toastTimer);
toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}

document.addEventListener('DOMContentLoaded', () => {
loadComments();
loadSoporte();
});
</script>

</body>
</html>}