@{
Layout = null;
ViewData["Title"] = "Crear cuenta";
}
<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Crear cuenta — HelpDesk</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    </head>
    <body>
        <div class="screen active" id="screen-register">
            <div class="auth-card" style="max-width:460px">
                <div class="auth-header">
                    <div class="auth-logo">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0z"/></svg>
                        <span>HelpDesk</span>
                    </div>
                    <h2>Crear cuenta</h2>
                    <p>Completa los datos para registrarte en el sistema</p>
                </div>
                <form asp-controller="Account" asp-action="Register" method="post" onsubmit="return validateRegisterClientSide()">
                    @Html.AntiForgeryToken()
                    <div class="auth-body">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-error show">
                                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
                                <span>@Html.ValidationSummary(true)</span>
                            </div>
                        }
                        <div class="field-row">
                            <div class="field">
                                <label>Nombre</label>
                                <input type="text" name="FirstName" placeholder="Ej: Ana" required>
                            </div>
                            <div class="field">
                                <label>Apellido</label>
                                <input type="text" name="LastName" placeholder="Ej: López" required>
                            </div>
                        </div>
                        <div class="field">
                            <label>Correo electrónico</label>
                            <input type="email" name="Email" placeholder="tu@correo.com" required>
                        </div>
                        <div class="field">
                            <label>Contraseña</label>
                            <div class="input-wrap">
                                <input type="password" name="Password" id="reg-pass" placeholder="Mínimo 8 caracteres" oninput="checkStrength(this.value)" required minlength="8">
                                <button type="button" class="toggle-pass" onclick="togglePass('reg-pass')" tabindex="-1">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                                </button>
                            </div>
                            <div class="pass-strength"><div class="pass-strength-fill" id="strength-bar"></div></div>
                            <div class="pass-hint" id="strength-hint">Escribe una contraseña</div>
                        </div>
                        <div class="field">
                            <label>Confirmar contraseña</label>
                            <input type="password" name="ConfirmPassword" id="reg-pass2" placeholder="Repite tu contraseña" required>
                            <span class="field-error" id="pass-match-err">Las contraseñas no coinciden.</span>
                        </div>

                        <div class="field">
                            <label>¿Cuál es tu rol?</label>
                            <div class="role-cards" id="role-cards">
                                <div class="role-card selected" id="card-usuario" onclick="selectRole('Usuario')">
                                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"></svg>
                                    <span>Usuario</span>
                                    <small>Crea y sigue tickets</small>
                                </div>
                                <div class="role-card" id="card-soporte" onclick="selectRole('Soporte')">
                                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z"/></svg>
                                    <span>Soporte</span>
                                    <small>Atiende tickets asignados</small>
                                </div>
                                <div class="role-card" id="card-supervisor" onclick="selectRole('Supervisor')">
                                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>
                                    <span>Supervisor</span>
                                    <small>Administra y asigna tickets</small>
                                </div>
                            </div>
                            <input type="hidden" name="Role" id="reg-role" value="Usuario">
                        </div>

                        <button type="submit" class="btn btn-primary btn-full">Crear cuenta</button>
                        <div class="auth-link">¿Ya tienes cuenta? <a asp-controller="Account" asp-action="Login">Inicia sesión</a></div>
                        <div class="auth-link" style="margin-top:-8px"><a asp-controller="Home" asp-action="Index" style="color:var(--text-muted);font-weight:400"> Volver al inicio</a></div>


                    </form>
                </div>
            </div>
            <div class="toast" id="toast">
                <svg width="16" height="16" fill="none" stroke="#10B981" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                <span id="toast-msg"></span>
            </div>
            <script src="~/js/auth.js" asp-append-version="true"></script>
            `<script>
                function selectRole(role) {
                document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
                document.getElementById('card-' + role.toLowerCase()).classList.add('selected');
                document.getElementById('reg-role').value = role;
            }
        </script>
    </body>
</html>